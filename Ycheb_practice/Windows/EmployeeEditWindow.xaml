<Window x:Class="Ycheb_practice.Windows.EmployeeEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сотрудник" Height="430" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="FL" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
        </Style>
        <Style x:Key="FI" TargetType="TextBox">
            <Setter Property="Height" Value="34"/><Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="13"/><Setter Property="BorderBrush" Value="#CBD5E0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Height" Value="36"/><Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <Border Background="White" Padding="26,20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="tbTitle" Text="Сотрудник"
                       FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="ФИО *"          Style="{StaticResource FL}"/>
                    <TextBox x:Name="tbName"          Style="{StaticResource FI}" MaxLength="100"/>
                    <TextBlock Text="Должность *"     Style="{StaticResource FL}"/>
                    <TextBox x:Name="tbPosition"      Style="{StaticResource FI}" MaxLength="100"/>
                    <TextBlock Text="Специализация"   Style="{StaticResource FL}"/>
                    <TextBox x:Name="tbSpec"          Style="{StaticResource FI}" MaxLength="255"/>
                    <TextBlock Text="Телефон"         Style="{StaticResource FL}"/>
                    <TextBox x:Name="tbPhone"         Style="{StaticResource FI}" MaxLength="20"/>
                    <TextBlock Text="Email"           Style="{StaticResource FL}"/>
                    <TextBox x:Name="tbEmail"         Style="{StaticResource FI}" MaxLength="100"/>
                    <TextBlock Text="Дата приёма *"   Style="{StaticResource FL}"/>
                    <DatePicker x:Name="dpHire" Height="34" FontSize="13"/>
                    <CheckBox x:Name="chkActive" Content="Активен" IsChecked="True"
                              FontSize="13" Margin="0,10,0,0"/>
                </StackPanel>
            </ScrollViewer>
            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/><ColumnDefinition Width="8"/>
                    <ColumnDefinition/><ColumnDefinition Width="8"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button Content="💾 Сохранить" Style="{StaticResource Btn}"
                        Background="#2C7BE5" Foreground="White" Click="BtnSave_Click"/>
                <Button Grid.Column="2" Content="✖ Отмена" Style="{StaticResource Btn}"
                        Background="#F1F5F9" Foreground="#475569" Click="BtnCancel_Click"/>
                <Button Grid.Column="4" x:Name="btnDelete" Content="🗑 Удалить"
                        Style="{StaticResource Btn}" Background="#FEF2F2"
                        Foreground="#DC2626" Visibility="Collapsed" Click="BtnDelete_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
