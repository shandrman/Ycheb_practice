<Window x:Class="Ycheb_practice.Windows.AttendanceMarkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Отметка посещения" Height="350" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="FL" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
        </Style>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Height" Value="36"/><Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <Border Background="White" Padding="26,20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Отметка посещения"
                       FontSize="16" FontWeight="Bold" Margin="0,0,0,6"/>
            <StackPanel Grid.Row="1">
                <TextBlock Text="Клиент *" Style="{StaticResource FL}"/>
                <ComboBox x:Name="cbClient" Height="34" FontSize="13"
                          DisplayMemberPath="FullName" SelectedValuePath="Id"/>
                <TextBlock Text="Тренировка *" Style="{StaticResource FL}"/>
                <ComboBox x:Name="cbTraining" Height="34" FontSize="13"
                          DisplayMemberPath="Name" SelectedValuePath="Id"/>
                <TextBlock Text="Дата *" Style="{StaticResource FL}"/>
                <DatePicker x:Name="dpDate" Height="34" FontSize="13"/>
                <TextBlock Text="Присутствовал" Style="{StaticResource FL}"/>
                <ComboBox x:Name="cbPresent" Height="34" FontSize="13">
                    <ComboBoxItem Content="Да" IsSelected="True"/>
                    <ComboBoxItem Content="Нет"/>
                </ComboBox>
            </StackPanel>
            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button Content="✅ Отметить" Style="{StaticResource Btn}"
                        Background="#2C7BE5" Foreground="White" Click="BtnSave_Click"/>
                <Button Grid.Column="2" Content="✖ Отмена" Style="{StaticResource Btn}"
                        Background="#F1F5F9" Foreground="#475569" Click="BtnCancel_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
