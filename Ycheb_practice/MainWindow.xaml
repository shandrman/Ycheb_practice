<Window x:Class="Ycheb_practice.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FitnessManager" Height="680" Width="1060"
        WindowStartupLocation="CenterScreen" Background="#F0F4F8"
        Loaded="Window_Loaded">
    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Grid x:Name="SidebarGrid" Grid.Column="0" Background="#1E2A3A">
            <Grid.RowDefinitions>
                <RowDefinition Height="72"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#162030">
                <StackPanel VerticalAlignment="Center" Margin="18,0">
                    <TextBlock Text="🏋 FitnessManager" Foreground="White"
                               FontSize="14" FontWeight="Bold"/>
                    <TextBlock Text="Городской метод" Foreground="#5A7A9F" FontSize="11"/>
                </StackPanel>
            </Border>

            <StackPanel x:Name="NavPanel" Grid.Row="1" Margin="0,8,0,0">
                <TextBlock Text="РАЗДЕЛЫ" Foreground="#4A6080" FontSize="10"
                           FontWeight="Bold" Margin="18,12,0,4"/>

                <Button Name="btnClients" Tag="Clients" Height="46"
                        HorizontalContentAlignment="Left" Padding="20,0"
                        BorderThickness="0" Cursor="Hand" FontSize="13"
                        Click="NavBtn_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="👥" Margin="0,0,10,0"/>
                        <TextBlock Text="Клиенты"/>
                    </StackPanel>
                </Button>

                <Button Name="btnSubscriptions" Tag="Subscriptions" Height="46"
                        HorizontalContentAlignment="Left" Padding="20,0"
                        BorderThickness="0" Cursor="Hand" FontSize="13"
                        Click="NavBtn_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🎫" Margin="0,0,10,0"/>
                        <TextBlock Text="Абонементы"/>
                    </StackPanel>
                </Button>

                <Button Name="btnTrainings" Tag="Trainings" Height="46"
                        HorizontalContentAlignment="Left" Padding="20,0"
                        BorderThickness="0" Cursor="Hand" FontSize="13"
                        Click="NavBtn_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📅" Margin="0,0,10,0"/>
                        <TextBlock Text="Расписание"/>
                    </StackPanel>
                </Button>

                <Button Name="btnAttendance" Tag="Attendance" Height="46"
                        HorizontalContentAlignment="Left" Padding="20,0"
                        BorderThickness="0" Cursor="Hand" FontSize="13"
                        Click="NavBtn_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✅" Margin="0,0,10,0"/>
                        <TextBlock Text="Посещаемость"/>
                    </StackPanel>
                </Button>

                <Button Name="btnEmployees" Tag="Employees" Height="46"
                        HorizontalContentAlignment="Left" Padding="20,0"
                        BorderThickness="0" Cursor="Hand" FontSize="13"
                        Click="NavBtn_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="👤" Margin="0,0,10,0"/>
                        <TextBlock Text="Персонал"/>
                    </StackPanel>
                </Button>

                <Button Name="btnServices" Tag="Services" Height="46"
                        HorizontalContentAlignment="Left" Padding="20,0"
                        BorderThickness="0" Cursor="Hand" FontSize="13"
                        Click="NavBtn_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💆" Margin="0,0,10,0"/>
                        <TextBlock Text="Услуги"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <Border Grid.Row="2" Background="#162030" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Name="tbUserName" Text="—"
                                   Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Name="tbUserRole" Text="—"
                                   Foreground="#5A7A9F" FontSize="11"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="⎋"
                            Foreground="#5A7A9F" Background="Transparent"
                            BorderThickness="0" FontSize="18" Cursor="Hand"
                            ToolTip="Выйти" Click="BtnLogout_Click"/>
                </Grid>
            </Border>
        </Grid>

        <!-- CONTENT -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="54"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White"
                    BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                <TextBlock Name="tbPageTitle" Text="Клиенты"
                           VerticalAlignment="Center" Margin="22,0"
                           FontSize="18" FontWeight="Bold" Foreground="#1A2535"/>
            </Border>

            <Frame Name="MainFrame" Grid.Row="1"
                   NavigationUIVisibility="Hidden"/>
        </Grid>
    </Grid>
</Window>
