<Page x:Class="Ycheb_practice.Pages.SubscriptionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F0F4F8" Title="Абонементы">
    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,0,0,14">
            <Button Content="+ Добавить тип" Height="32" Padding="14,0"
                    FontSize="13" Background="#10B981" Foreground="White"
                    BorderThickness="0" Cursor="Hand" Click="BtnAdd_Click"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.07"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DataGrid x:Name="dgSubs" AutoGenerateColumns="False"
                          CanUserAddRows="False" IsReadOnly="True"
                          GridLinesVisibility="Horizontal" BorderThickness="0"
                          RowHeight="38" FontSize="13" AlternatingRowBackground="#F8FAFC"
                          ColumnHeaderHeight="40" MouseDoubleClick="Dg_DoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID"          Binding="{Binding Id}"           Width="50"/>
                        <DataGridTextColumn Header="Тип"         Binding="{Binding TypeName}"     Width="*"/>
                        <DataGridTextColumn Header="Цена (руб.)" Binding="{Binding Price, StringFormat=N2}" Width="110"/>
                        <DataGridTextColumn Header="Дней"        Binding="{Binding DurationDays}" Width="70"/>
                        <DataGridTextColumn Header="Визитов"     Binding="{Binding VisitsLimit}"  Width="80"/>
                        <DataGridTextColumn Header="Активен"     Binding="{Binding IsActiveStr}"  Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Border Grid.Row="1" Background="#F8FAFC"
                        BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="14,7">
                    <TextBlock x:Name="tbStatus" Foreground="#6B7280" FontSize="12"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
