<Window x:Class="Ycheb_practice.Windows.ServiceEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Услуга" Height="380" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="FL" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
        </Style>
        <Style x:Key="FI" TargetType="TextBox">
            <Setter Property="Height" Value="34"/><Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="13"/><Setter Property="BorderBrush" Value="#CBD5E0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Height" Value="36"/><Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <Border Background="White" Padding="26,20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="tbTitle" Text="Услуга"
                       FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>
            <StackPanel Grid.Row="1">
                <TextBlock Text="Название *"   Style="{StaticResource FL}"/>
                <TextBox x:Name="tbName"       Style="{StaticResource FI}" MaxLength="100"/>
                <TextBlock Text="Категория *"  Style="{StaticResource FL}"/>
                <ComboBox x:Name="cbCat" Height="34" FontSize="13">
                    <ComboBoxItem Content="SPA"      IsSelected="True"/>
                    <ComboBoxItem Content="wellness"/>
                    <ComboBoxItem Content="beauty"/>
                    <ComboBoxItem Content="nutrition"/>
                    <ComboBoxItem Content="training"/>
                </ComboBox>
                <TextBlock Text="Цена (руб.) *" Style="{StaticResource FL}"/>
                <TextBox x:Name="tbPrice"       Style="{StaticResource FI}"/>
                <TextBlock Text="Описание"      Style="{StaticResource FL}"/>
                <TextBox x:Name="tbDesc" Height="55" Padding="8,6" FontSize="13"
                         BorderBrush="#CBD5E0" TextWrapping="Wrap" AcceptsReturn="True"/>
                <CheckBox x:Name="chkActive" Content="Услуга активна" IsChecked="True"
                          FontSize="13" Margin="0,10,0,0"/>
            </StackPanel>
            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/><ColumnDefinition Width="8"/>
                    <ColumnDefinition/><ColumnDefinition Width="8"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button Content="💾 Сохранить" Style="{StaticResource Btn}"
                        Background="#2C7BE5" Foreground="White" Click="BtnSave_Click"/>
                <Button Grid.Column="2" Content="✖ Отмена" Style="{StaticResource Btn}"
                        Background="#F1F5F9" Foreground="#475569" Click="BtnCancel_Click"/>
                <Button Grid.Column="4" x:Name="btnDelete" Content="🗑 Удалить"
                        Style="{StaticResource Btn}" Background="#FEF2F2"
                        Foreground="#DC2626" Visibility="Collapsed" Click="BtnDelete_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
