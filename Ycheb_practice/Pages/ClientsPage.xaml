<Page x:Class="Ycheb_practice.Pages.ClientsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F0F4F8" Title="Клиенты">
    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Панель фильтров и кнопок -->
        <Border Grid.Row="0" Background="White" CornerRadius="8"
                Padding="14,10" Margin="0,0,0,14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.07"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="tbSearch" Grid.Column="0"
                         Height="32" Padding="8,0" FontSize="13"
                         VerticalContentAlignment="Center"
                         BorderBrush="#CBD5E0"
                         TextChanged="TbSearch_TextChanged"/>

                <ComboBox x:Name="cbStatus" Grid.Column="2"
                          Height="32" FontSize="13"
                          SelectionChanged="CbStatus_Changed">
                    <ComboBoxItem Content="Все статусы" IsSelected="True"/>
                    <ComboBoxItem Content="active"/>
                    <ComboBoxItem Content="inactive"/>
                    <ComboBoxItem Content="blocked"/>
                </ComboBox>

                <Button Grid.Column="4" Content="Сброс"
                        Height="32" Padding="8,0" FontSize="13"
                        Background="#F1F5F9" Foreground="#475569"
                        BorderThickness="0" Cursor="Hand"
                        Click="BtnReset_Click"/>

                <Button Grid.Column="6" Content="+ Добавить"
                        Height="32" Padding="14,0" FontSize="13"
                        Background="#10B981" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        Click="BtnAdd_Click"/>
            </Grid>
        </Border>

        <!-- Таблица -->
        <Border Grid.Row="1" Background="White" CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.07"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid x:Name="dgClients" Grid.Row="0"
                          AutoGenerateColumns="False" CanUserAddRows="False"
                          IsReadOnly="True" GridLinesVisibility="Horizontal"
                          BorderThickness="0" RowHeight="38" FontSize="13"
                          AlternatingRowBackground="#F8FAFC" ColumnHeaderHeight="40"
                          MouseDoubleClick="Dg_DoubleClick">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8FAFC"/>
                            <Setter Property="Foreground" Value="#6B7280"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="10,0" Background="{TemplateBinding Background}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID"      Binding="{Binding Id}"               Width="50"/>
                        <DataGridTextColumn Header="ФИО"     Binding="{Binding FullName}"          Width="*"/>
                        <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}"             Width="130"/>
                        <DataGridTextColumn Header="Email"   Binding="{Binding Email}"             Width="170"/>
                        <DataGridTextColumn Header="Регистрация" Binding="{Binding RegistrationDate}" Width="110"/>
                        <DataGridTextColumn Header="Статус"  Binding="{Binding Status}"            Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="1" Background="#F8FAFC"
                        BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="14,7">
                    <TextBlock x:Name="tbStatus" Foreground="#6B7280" FontSize="12"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
