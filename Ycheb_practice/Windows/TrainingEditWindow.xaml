<Window x:Class="Ycheb_practice.Windows.TrainingEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Тренировка" Height="450" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="FL" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
        </Style>
        <Style x:Key="FI" TargetType="TextBox">
            <Setter Property="Height" Value="34"/><Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="13"/><Setter Property="BorderBrush" Value="#CBD5E0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Height" Value="36"/><Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <Border Background="White" Padding="26,20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="tbTitle" Text="Тренировка"
                       FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Название *"      Style="{StaticResource FL}"/>
                    <TextBox x:Name="tbName"          Style="{StaticResource FI}" MaxLength="100"/>
                    <TextBlock Text="Тренер *"         Style="{StaticResource FL}"/>
                    <ComboBox x:Name="cbEmployee" Height="34" FontSize="13"
                              DisplayMemberPath="FullName" SelectedValuePath="Id"/>
                    <TextBlock Text="День недели *"   Style="{StaticResource FL}"/>
                    <ComboBox x:Name="cbDay" Height="34" FontSize="13">
                        <ComboBoxItem Content="Понедельник" Tag="1" IsSelected="True"/>
                        <ComboBoxItem Content="Вторник"     Tag="2"/>
                        <ComboBoxItem Content="Среда"       Tag="3"/>
                        <ComboBoxItem Content="Четверг"     Tag="4"/>
                        <ComboBoxItem Content="Пятница"     Tag="5"/>
                        <ComboBoxItem Content="Суббота"     Tag="6"/>
                        <ComboBoxItem Content="Воскресенье" Tag="0"/>
                    </ComboBox>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Начало (ЧЧ:ММ)" Style="{StaticResource FL}"/>
                            <TextBox x:Name="tbStart" Style="{StaticResource FI}" Text="09:00"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Конец (ЧЧ:ММ)" Style="{StaticResource FL}"/>
                            <TextBox x:Name="tbEnd" Style="{StaticResource FI}" Text="10:00"/>
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Зал *"            Style="{StaticResource FL}"/>
                            <TextBox x:Name="tbHall"           Style="{StaticResource FI}" MaxLength="50"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Макс. участников" Style="{StaticResource FL}"/>
                            <TextBox x:Name="tbMax"            Style="{StaticResource FI}" Text="20"/>
                        </StackPanel>
                    </Grid>
                    <CheckBox x:Name="chkActive" Content="Тренировка активна"
                              IsChecked="True" FontSize="13" Margin="0,10,0,0"/>
                </StackPanel>
            </ScrollViewer>
            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/><ColumnDefinition Width="8"/>
                    <ColumnDefinition/><ColumnDefinition Width="8"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button Content="💾 Сохранить" Style="{StaticResource Btn}"
                        Background="#2C7BE5" Foreground="White" Click="BtnSave_Click"/>
                <Button Grid.Column="2" Content="✖ Отмена" Style="{StaticResource Btn}"
                        Background="#F1F5F9" Foreground="#475569" Click="BtnCancel_Click"/>
                <Button Grid.Column="4" x:Name="btnDelete" Content="🗑 Удалить"
                        Style="{StaticResource Btn}" Background="#FEF2F2"
                        Foreground="#DC2626" Visibility="Collapsed" Click="BtnDelete_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
