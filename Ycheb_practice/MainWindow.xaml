<Window x:Class="Ycheb_practice.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="FitnessManager — Клиенты" Height="520" Width="920"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель: заголовок + кнопка пересоздания БД -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Список клиентов — через ManagerService"
                       FontSize="14" FontWeight="Bold"
                       VerticalAlignment="Center"/>

            <Button Grid.Column="1"
                    Content="🔄 Пересоздать БД"
                    Width="160" Height="32"
                    Background="#E74C3C" Foreground="White"
                    BorderThickness="0"
                    Click="BtnRecreateDatabase_Click"/>
        </Grid>

        <!-- DataGrid клиентов -->
        <DataGrid x:Name="dgClients"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="#F5F5F5"
                  RowHeight="30"
                  ColumnHeaderHeight="36">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"
                                    Binding="{Binding Id}"
                                    Width="50"/>
                <DataGridTextColumn Header="ФИО"
                                    Binding="{Binding FullName}"
                                    Width="200"/>
                <DataGridTextColumn Header="Телефон"
                                    Binding="{Binding Phone}"
                                    Width="130"/>
                <DataGridTextColumn Header="Email"
                                    Binding="{Binding Email}"
                                    Width="180"/>
                <DataGridTextColumn Header="Дата рождения"
                                    Binding="{Binding BirthDate}"
                                    Width="120"/>
                <DataGridTextColumn Header="Дата регистрации"
                                    Binding="{Binding RegistrationDate}"
                                    Width="130"/>
                <DataGridTextColumn Header="Статус"
                                    Binding="{Binding Status}"
                                    Width="90"/>
                <DataGridTextColumn Header="Заметки"
                                    Binding="{Binding Notes}"
                                    Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Статусная строка -->
        <TextBlock x:Name="tbStatus"
                   Grid.Row="2"
                   Margin="0,8,0,0"
                   Foreground="Gray"
                   FontSize="12"/>
    </Grid>
</Window>
