<Page x:Class="Ycheb_practice.Pages.AttendancePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F0F4F8" Title="Посещаемость">
    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="tbSearch" Height="32" Padding="8,0" FontSize="13"
                     BorderBrush="#CBD5E0" VerticalContentAlignment="Center"
                     Background="White" TextChanged="Filter_Changed"/>
            <DatePicker x:Name="dpFrom" Grid.Column="2" Height="32" FontSize="13"
                        BorderBrush="#CBD5E0" SelectedDateChanged="Filter_Changed"/>
            <DatePicker x:Name="dpTo"   Grid.Column="4" Height="32" FontSize="13"
                        BorderBrush="#CBD5E0" SelectedDateChanged="Filter_Changed"/>
            <Button Grid.Column="6" Content="+ Отметить" Height="32" Padding="14,0"
                    FontSize="13" Background="#2C7BE5" Foreground="White"
                    BorderThickness="0" Cursor="Hand" Click="BtnAdd_Click"/>
        </Grid>

        <Border Grid.Row="1" Background="White" CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.07"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DataGrid x:Name="dgAttendance" AutoGenerateColumns="False"
                          CanUserAddRows="False" IsReadOnly="True"
                          GridLinesVisibility="Horizontal" BorderThickness="0"
                          RowHeight="38" FontSize="13" AlternatingRowBackground="#F8FAFC"
                          ColumnHeaderHeight="40">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Клиент"      Binding="{Binding ClientName}"   Width="*"/>
                        <DataGridTextColumn Header="Тренировка"  Binding="{Binding TrainingName}" Width="170"/>
                        <DataGridTextColumn Header="Дата"        Binding="{Binding DateStr}"      Width="100"/>
                        <DataGridTextColumn Header="Присутствовал" Binding="{Binding PresentStr}" Width="120"/>
                        <DataGridTextColumn Header="Время отметки" Binding="{Binding MarkStr}"   Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Border Grid.Row="1" Background="#F8FAFC"
                        BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="14,7">
                    <TextBlock x:Name="tbStatus" Foreground="#6B7280" FontSize="12"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
