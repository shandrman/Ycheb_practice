<Window x:Class="Ycheb_practice.Windows.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FitnessManager — Вход" Height="380" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
        </Style>
        <Style x:Key="PwdStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
        </Style>
        <Style x:Key="BtnStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#2C7BE5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Border Background="White" Padding="36,30">
        <StackPanel>
            <TextBlock Text="🏋 FitnessManager" FontSize="22" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,4"/>
            <TextBlock Text="Городской метод" FontSize="13" Foreground="Gray"
                       HorizontalAlignment="Center" Margin="0,0,0,28"/>

            <TextBlock Text="Логин" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="tbLogin" Style="{StaticResource InputStyle}"
                     Text="admin" KeyDown="Input_KeyDown"/>

            <TextBlock Text="Пароль" FontWeight="SemiBold" Margin="0,14,0,5"/>
            <PasswordBox x:Name="pbPassword" Style="{StaticResource PwdStyle}"
                         PasswordChar="●" KeyDown="Input_KeyDown"/>

            <Border x:Name="ErrorBorder" Background="#FEF2F2" BorderBrush="#FCA5A5"
                    BorderThickness="1" CornerRadius="4" Padding="10,6"
                    Margin="0,10,0,0" Visibility="Collapsed">
                <TextBlock x:Name="tbError" Foreground="#DC2626" FontSize="13"/>
            </Border>

            <Button Content="Войти" Style="{StaticResource BtnStyle}"
                    Margin="0,20,0,0" Click="BtnLogin_Click"/>

            <Border Background="#EFF6FF" CornerRadius="4" Padding="10,7" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Демо: admin / admin123" FontSize="12" Foreground="#2563EB"/>
                    <TextBlock Text="Демо: trainer / trainer123" FontSize="12" Foreground="#2563EB"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
