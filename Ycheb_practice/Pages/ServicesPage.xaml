<Page x:Class="Ycheb_practice.Pages.ServicesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F0F4F8" Title="Услуги">
    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="tbSearch" Height="32" Padding="8,0" FontSize="13"
                     BorderBrush="#CBD5E0" VerticalContentAlignment="Center"
                     Background="White" TextChanged="TbSearch_TextChanged"/>
            <ComboBox x:Name="cbCategory" Grid.Column="2" Height="32" FontSize="13"
                      SelectionChanged="CbCat_Changed">
                <ComboBoxItem Content="Все категории" IsSelected="True"/>
                <ComboBoxItem Content="SPA"/>
                <ComboBoxItem Content="wellness"/>
                <ComboBoxItem Content="beauty"/>
                <ComboBoxItem Content="nutrition"/>
                <ComboBoxItem Content="training"/>
            </ComboBox>
            <Button Grid.Column="4" Content="+ Добавить" Height="32" Padding="14,0"
                    FontSize="13" Background="#10B981" Foreground="White"
                    BorderThickness="0" Cursor="Hand" Click="BtnAdd_Click"/>
        </Grid>

        <Border Grid.Row="1" Background="White" CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.07"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DataGrid x:Name="dgServices" AutoGenerateColumns="False"
                          CanUserAddRows="False" IsReadOnly="True"
                          GridLinesVisibility="Horizontal" BorderThickness="0"
                          RowHeight="38" FontSize="13" AlternatingRowBackground="#F8FAFC"
                          ColumnHeaderHeight="40" MouseDoubleClick="Dg_DoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Название"    Binding="{Binding Name}"        Width="*"/>
                        <DataGridTextColumn Header="Категория"   Binding="{Binding Category}"    Width="110"/>
                        <DataGridTextColumn Header="Цена (руб.)" Binding="{Binding Price, StringFormat=N2}" Width="110"/>
                        <DataGridTextColumn Header="Описание"    Binding="{Binding Description}" Width="220"/>
                        <DataGridTextColumn Header="Активна"     Binding="{Binding ActiveStr}"   Width="75"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Border Grid.Row="1" Background="#F8FAFC"
                        BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="14,7">
                    <TextBlock x:Name="tbStatus" Foreground="#6B7280" FontSize="12"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
