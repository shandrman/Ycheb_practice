<Window x:Class="Ycheb_practice.Windows.ClientEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Клиент" Height="480" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="FL" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,12,0,5"/>
        </Style>
        <Style x:Key="FI" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#CBD5E0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Border Background="White" Padding="28,22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="tbTitle" Text="Клиент"
                       FontSize="17" FontWeight="Bold" Margin="0,0,0,6"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="ФИО *" Style="{StaticResource FL}"/>
                    <TextBox x:Name="tbFullName" Style="{StaticResource FI}" MaxLength="100"/>

                    <TextBlock Text="Телефон *" Style="{StaticResource FL}"/>
                    <TextBox x:Name="tbPhone" Style="{StaticResource FI}" MaxLength="20"/>

                    <TextBlock Text="Email" Style="{StaticResource FL}"/>
                    <TextBox x:Name="tbEmail" Style="{StaticResource FI}" MaxLength="100"/>

                    <TextBlock Text="Дата рождения" Style="{StaticResource FL}"/>
                    <DatePicker x:Name="dpBirth" Height="34" FontSize="13"/>

                    <TextBlock Text="Статус" Style="{StaticResource FL}"/>
                    <ComboBox x:Name="cbStatus" Height="34" FontSize="13">
                        <ComboBoxItem Content="active"   IsSelected="True"/>
                        <ComboBoxItem Content="inactive"/>
                        <ComboBoxItem Content="blocked"/>
                    </ComboBox>

                    <TextBlock Text="Заметки" Style="{StaticResource FL}"/>
                    <TextBox x:Name="tbNotes" Height="60" Padding="8,6"
                             FontSize="13" BorderBrush="#CBD5E0"
                             TextWrapping="Wrap" AcceptsReturn="True"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Кнопки -->
            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Content="💾 Сохранить" Style="{StaticResource Btn}"
                        Background="#2C7BE5" Foreground="White" Click="BtnSave_Click"/>
                <Button Grid.Column="2" Content="✖ Отмена" Style="{StaticResource Btn}"
                        Background="#F1F5F9" Foreground="#475569" Click="BtnCancel_Click"/>
                <Button Grid.Column="4" x:Name="btnDelete" Content="🗑 Удалить"
                        Style="{StaticResource Btn}" Background="#FEF2F2"
                        Foreground="#DC2626" Visibility="Collapsed" Click="BtnDelete_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
